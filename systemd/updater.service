[Unit]
Description=Local VPS updater
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=simple
ExecStart=/usr/bin/updater serve
Restart=on-failure
RestartSec=3
User=root
Group=updater
UMask=0007
EnvironmentFile=/etc/exocortex/updater/.env
LogRateLimitIntervalSec=30s
LogRateLimitBurst=200
RuntimeDirectory=exocortex
RuntimeDirectoryPreserve=yes
StateDirectory=updater
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run/exocortex -/run/neptune -/run/gryphon -/run/gryphon-admin /var/lib/updater -/var/lib/neptune -/var/lib/gryphon -/var/cache/neptune /etc/exocortex -/etc/neptune -/etc/gryphon -/etc/vault /opt/exocortex -/opt/volt -/opt/vault -/usr/local/lib/neptune -/usr/local/lib/gryphon /usr/local/lib/updater

[Install]
WantedBy=multi-user.target
